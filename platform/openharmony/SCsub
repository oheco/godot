#!/usr/bin/env python
from misc.utility.scons_hints import *

import importlib.util
import os
from pathlib import Path
import shutil
import tempfile

from methods import print_warning

Import("env")


def generate_bundle(target, source, env):
    spec = importlib.util.spec_from_file_location(
        "openharmony_project_config", File("#platform/openharmony/project_config.py").abspath
    )
    project_config = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(project_config)
    # Never mutate the source template or package IDE caches/stale binaries.
    with tempfile.TemporaryDirectory(prefix="godot-ohos-template-", dir=os.environ.get("TMPDIR")) as staging:
        project = Path(staging)
        project_config.stage_template(project)
        config = project_config.configuration(overrides={
            "build": {"architectures": [lib_arch_dir]}, "engine": {"target": env["target"]}
        })
        project_config.configure_project(project, config, keep_history=False)
        native = project / "entry/libs" / lib_arch_dir
        native.mkdir(parents=True)
        shutil.copyfile(lib[0].abspath, native / "libgodot.so")
        include = project / "entry/src/main/cpp/include"
        include.mkdir(parents=True)
        for header in project_config.HEADERS:
            shutil.copyfile(File("#platform/openharmony/" + header).abspath, include / header)
        project_config.write_document(project / "entry/src/main/resources/rawfile/godot_template.json", {
            "hostAbi": project_config.HOST_ABI_VERSION,
            "monoEnabled": bool(env["module_mono_enabled"]),
            "nativeAotEnabled": bool(env["module_mono_enabled"]),
            "architecture": lib_arch_dir,
            "target": env["target"],
        })
        shutil.make_archive(Dir(f"#bin/openharmony_{lib_type_dir}_{lib_arch_dir}").abspath, "zip", root_dir=project)


openharmony_files = [Glob("*.cpp")]

env_openharmony = env.Clone()

openharmony_objects = []
for x in openharmony_files:
    openharmony_objects.append(env_openharmony.SharedObject(x))

lib_arch_dir = ""
if env["arch"] == "arm64":
    lib_arch_dir = "arm64-v8a"
elif env["arch"] == "x86_64":
    lib_arch_dir = "x86_64"
else:
    print_warning("Architecture not suitable for embedding into APP; keeping .so at \\bin")

if lib_arch_dir != "":
    if env.dev_build:
        lib_type_dir = "dev"
    elif env.debug_features:
        lib_type_dir = "debug"
    else:  # Release
        lib_type_dir = "release"

    lib_arch = env["arch"]
    lib_name = "#bin/libgodot"
    lib = env_openharmony.add_shared_library(lib_name, [openharmony_objects])

    if env["generate_bundle"]:
        generate_bundle_command = env.Command("generate_bundle", [], generate_bundle)
        command = env.AlwaysBuild(generate_bundle_command)
        env.Depends(command, [lib])
